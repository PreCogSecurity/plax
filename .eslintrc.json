{
  "root": true,
  "env": {
    "browser": true,
    "jquery": true,
    "node": true,
    "jest": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "globals": {
    "ender": "readonly"
  },
  "rules": {
    "no-unused-vars": ["error", { "args": "none" }]
  }
}